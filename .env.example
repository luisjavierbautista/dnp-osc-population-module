# Application
PROJECT_NAME="Módulo de Población - DNP"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=false

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=population_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=population_db
POSTGRES_PORT=5432

# Security
SECRET_KEY=CHANGE-THIS-SECRET-KEY-IN-PRODUCTION-USE-STRONG-RANDOM-STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Allowed origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# Database pool
MAX_CONNECTIONS_COUNT=10
MIN_CONNECTIONS_COUNT=5

# AI / LLM Configuration
# Choose one or both providers (system will use Azure OpenAI as default if both are configured)

# Option 1: Claude (Anthropic)
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Option 2: Azure OpenAI (DNP Official)
# Contact DNP for access credentials
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Legacy OpenAI (not recommended, use Azure OpenAI or Claude instead)
# OPENAI_API_KEY=your-openai-api-key-here
